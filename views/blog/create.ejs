<main class="lg:ml-72 p-6 mx-auto px-6 py-8">
  
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'true') {
      document.write(`
        <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm rounded-xl flex items-center gap-2 animate-fade-in my-4">
          <i class="fa-solid fa-circle-check"></i>
          <span>Artikel blog berhasil disimpan dan diperbarui!</span>
        </div>
      `);
      window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('deleted') === 'true') {
      document.write(`
        <div class="p-4 bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm rounded-xl flex items-center gap-2 animate-fade-in my-4">
          <i class="fa-solid fa-trash-can"></i>
          <span>Artikel blog berhasil dihapus secara permanen.</span>
        </div>
      `);
      window.history.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>

  <div class="bg-slate-800 border border-slate-700/70 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-6 border-b border-slate-700/50 bg-slate-800/50">
      <h2 class="text-lg font-bold flex items-center gap-2 text-emerald-400">
        <i class="fa-solid fa-pen-to-square"></i> Tulis Artikel Blog Baru
      </h2>
    </div>

    <form action="/dashboard/blog/store" method="POST" id="blogForm" class="p-6 space-y-5">
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Judul Artikel</label>
        <input type="text" name="title" required
          class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 text-sm transition"
          placeholder="Contoh: Cara Integrasi Google Sheets ke WhatsApp API Gateway">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Meta Description (SEO)</label>
        <textarea name="metaDesc" rows="2" maxlength="160" required
          class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 text-sm transition"
          placeholder="Tulis ringkasan pendek artikel maksimal 160 karakter untuk Google..."></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Isi Konten Artikel</label>
        <div class="bg-slate-900 rounded-xl border border-slate-700 overflow-hidden text-slate-200">
          <div id="editor" class="min-h-[250px] text-sm"></div>
        </div>
        <input type="hidden" name="content" id="contentInput">
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-slate-700/50">
        <div class="w-full sm:w-1/3">
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Status Publikasi</label>
          <select name="status" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500 transition cursor-pointer">
            <option value="published" class="bg-slate-900">🚀 Publish Langsung</option>
            <option value="draft" class="bg-slate-900">📁 Simpan Sebagai Draft</option>
          </select>
        </div>

        <div class="flex justify-end pt-2 sm:pt-0">
          <button type="submit" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-6 py-2.5 rounded-xl text-sm transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-cloud-arrow-up"></i> Simpan Artikel
          </button>
        </div>
      </div>
    </form>
  </div>

  <div class="bg-slate-800 border border-slate-700/70 rounded-2xl shadow-xl overflow-hidden mt-6">
    <div class="p-6 border-b border-slate-700/50 bg-slate-800/50 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-slate-200 flex items-center gap-2">
          <i class="fa-solid fa-list-check text-emerald-400"></i> Daftar Seluruh Artikel
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">Total terdata: <%= articles.length %> artikel</p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm text-slate-300">
        <thead>
          <tr class="bg-slate-900/50 text-slate-400 text-xs font-semibold uppercase border-b border-slate-700/50">
            <th class="px-6 py-3.5">Judul Artikel</th>
            <th class="px-6 py-3.5">Tanggal</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/40">
          <% if (articles.length === 0) { %>
            <tr>
              <td colspan="4" class="px-6 py-10 text-center text-slate-500 text-xs">
                Belum ada artikel di database. Silakan isi form di atas untuk menambahkan.
              </td>
            </tr>
          <% } else { %>
            <% articles.forEach(article => { %>
              <tr class="hover:bg-slate-700/20 transition">
                <td class="px-6 py-4">
                  <div class="font-semibold text-slate-200 max-w-xs md:max-w-md truncate" title="<%= article.title %>">
                    <%= article.title %>
                  </div>
                  <span class="text-[11px] text-slate-500 block truncate max-w-xs">/blog/<%= article.slug %></span>
                </td>
                
                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap">
                  <%= new Date(article.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>

                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (article.status === 'published') { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      Published
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      Draft
                    </span>
                  <% } %>
                </td>

   <td class="px-6 py-4 whitespace-nowrap text-center text-xs font-medium">
  <div class="flex items-center justify-center gap-2">
    <a href="/blog/<%= article.slug %>" target="_blank" class="p-1.5 bg-slate-700 hover:bg-slate-600 rounded-lg text-slate-300 transition" title="Lihat Artikel">
      <i class="fa-solid fa-eye text-xs"></i>
    </a>
    
    <a href="/dashboard/blog/edit/<%= article._id %>" class="p-1.5 bg-amber-500/10 hover:bg-amber-500 border border-amber-500/20 hover:border-transparent rounded-lg text-amber-400 hover:text-white transition" title="Edit Artikel">
      <i class="fa-solid fa-pencil text-xs"></i>
    </a>
    
    <form action="/dashboard/blog/delete/<%= article._id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus artikel ini secara permanen?');" class="inline">
      <button type="submit" class="p-1.5 bg-rose-500/10 hover:bg-rose-500 border border-rose-500/20 hover:border-transparent rounded-lg text-rose-400 hover:text-white transition cursor-pointer">
        <i class="fa-solid fa-trash text-xs"></i>
      </button>
    </form>
  </div>
</td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

<style>
  .ql-toolbar.ql-snow { background-color: #1e293b !important; border-color: #334155 !important; border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem; }
  .ql-container.ql-snow { border-color: #334155 !important; border-bottom-left-radius: 0.75rem; border-bottom-right-radius: 0.75rem; background-color: #0f172a; }
  .ql-snow .ql-stroke { stroke: #94a3b8 !important; }
  .ql-snow .ql-fill { fill: #94a3b8 !important; }
  .ql-snow .ql-picker { color: #94a3b8 !important; }
  .ql-editor.ql-blank::before { color: #64748b !important; font-style: normal !important; }
  .ql-editor { color: #f1f5f9 !important; font-family: ui-sans-serif, system-ui, sans-serif; min-height: 280px; }
  
  /* Styling khusus tampilan kode di dalam text editor biar cakep */
  .ql-editor pre.ql-syntax {
    background-color: #1e293b !important;
    color: #38bdf8 !important;
    border-left: 4px solid #10b981 !important;
    padding: 12px !important;
    border-radius: 8px !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
  }
</style>

<script>
  // Inisialisasi Quill Editor dengan Modul Lengkap (Gambar + Kode Blok)
  const quill = new Quill('#editor', {
    theme: 'snow',
    placeholder: 'Tulis isi tutorial berbobot Anda di sini... (Gunakan tombol gambar untuk upload screenshoot & ikon </> untuk menulis sintaks kode)',
    modules: {
      toolbar: [
        [{ 'header': [1, 2, 3, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['link', 'blockquote', 'code-block', 'image'], // 🎯 AKTIFKAN FITUR 'image' & 'code-block' DI SINI
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        ['clean']
      ]
    }
  });

  // Handler Kirim Form / Validasi Data sebelum Masuk DB
  const form = document.getElementById('blogForm');
  form.onsubmit = function() {
    const contentInput = document.getElementById('contentInput');
    const htmlContent = quill.root.innerHTML;
    
    if (htmlContent === '<p><br></p>' || htmlContent.trim() === '') {
      alert('Isi konten artikel blog tidak boleh kosong!');
      return false;
    }
    
    // Oper semua HTML mentah (termasuk tag <pre> kode dan <img> base64) ke input hidden database
    contentInput.value = htmlContent;
  };
</script>
</script>