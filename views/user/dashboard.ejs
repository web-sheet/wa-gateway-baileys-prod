// 🟢 PERUBAHAN 3: Fungsi Javascipt AJAX pintar untuk refresh tabel tanpa reload halaman
async function refreshLogTable() {
  const refreshIcon = document.getElementById('refreshIcon');
  const tbody = document.getElementById('logsTable');
  
  // Efek animasi berputar pada ikon saat mengambil data
  refreshIcon.classList.add('fa-spin');

  try {
    // Panggil rute API JSON data log (pastikan rute /wa/logs kamu mengembalikan data JSON murni)
    const response = await fetch('/wa/logs'); 
    const result = await response.json();
    
    if (!result.success || result.data.length === 0) {
      refreshIcon.classList.remove('fa-spin');
      return;
    }

    tbody.innerHTML = ''; // Kosongkan baris lama

    // Kita batasi hanya memuat 10 log pesan paling baru agar pas diletakkan di bawah dashboard
    const limitedLogs = result.data.slice(0, 10);

    limitedLogs.forEach(log => {
      const waktu = new Date(log.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' });
      
      // Hitung badge status pengiriman
      let statusBadge = `<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-500/15 text-yellow-400 text-xs"><i class="fa-solid fa-clock"></i> Antri</span>`;
      if (log.status === 'sent') {
        statusBadge = `<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-400 text-xs"><i class="fa-solid fa-circle-check"></i> Terkirim</span>`;
      } else if (log.status === 'failed') {
        statusBadge = `<span title="${log.errorReason || ''}" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/15 text-red-400 text-xs cursor-help"><i class="fa-solid fa-circle-xmark"></i> Gagal</span>`;
      }

      // Hitung tipe pesan dan ikonnya
      let tipeText = `<span class="inline-flex items-center gap-2 text-indigo-400"><i class="fa-solid fa-comment"></i> Teks</span>`;
      if (log.messageType === 'image') {
        tipeText = `<span class="inline-flex items-center gap-2 text-emerald-400"><i class="fa-solid fa-image"></i> Gambar</span>`;
      } else if (log.messageType === 'document') {
        tipeText = `<span class="inline-flex items-center gap-2 text-yellow-400"><i class="fa-solid fa-file-lines"></i> Dokumen</span>`;
      }

      // Hitung tombol lampiran media
      let mediaContent = '<span class="text-slate-500">-</span>';
      if (log.mediaUrl) {
        const linkText = log.messageType === 'document' ? (log.fileName || 'Lihat Berkas') : 'Lihat';
        mediaContent = `<a href="${log.mediaUrl}" target="_blank" class="text-emerald-400 hover:text-emerald-300 transition inline-flex items-center gap-1"><i class="fa-solid fa-arrow-up-right-from-square text-xs"></i> ${linkText}</a>`;
      }

      let nomor = log.to.split('@')[0];
      let badgeGrup = log.to.includes('@g.us') ? `<span class="inline-flex w-fit px-2 py-1 rounded-full bg-cyan-500/20 text-cyan-400 text-xs">Grup</span>` : '';

      // Tumpuk data ke row tabel HTML baru
      const row = `
        <tr class="border-b border-white/5 hover:bg-white/5 transition">
          <td class="px-4 py-4 whitespace-nowrap text-slate-400">${waktu}</td>
          <td class="px-4 py-4"><div class="flex flex-col gap-1"><span class="font-mono text-xs text-white">${nomor}</span>${badgeGrup}</div></td>
          <td class="px-4 py-4">${tipeText}</td>
          <td class="px-4 py-4"><div class="max-w-md line-clamp-2 text-slate-300">${log.message || 'Tanpa teks'}</div></td>
          <td class="px-4 py-4">${mediaContent}</td>
          <td class="px-4 py-4">${statusBadge}</td>
        </tr>
      `;
      tbody.insertAdjacentHTML('beforeend', row);
    });

  } catch (error) {
    console.error("Gagal melakukan AJAX refresh log:", error);
  } finally {
    // Matikan efek berputar ikon refresh setelah selesai proses
    setTimeout(() => refreshIcon.classList.remove('fa-spin'), 600);
  }
}






let currentPage = 1; // Menyimpan status halaman aktif saat ini

// 🔄 Fungsi Refresh (Mengulang dari halaman 1 dan mengosongkan tabel)
async function refreshLogTable() {
  const refreshIcon = document.getElementById('refreshIcon');
  const tbody = document.getElementById('logsTable');
  const totalCountBadge = document.getElementById('totalPesanCount'); // 🟢 Ambil element badge angka
  
  refreshIcon.classList.add('fa-spin');
  currentPage = 1;

  try {
    const response = await fetch('/wa/logs?page=1'); 
    const result = await response.json();
    
    if (!result.success) return;

    // 🟢 UPDATE ANGKA TOTAL DI HEADER SECARA REAL-TIME
    if (result.total !== undefined) {
      totalCountBadge.innerText = `${result.total} Pesan`;
    }

    tbody.innerHTML = ''; 
    renderRows(result.data);
    toggleLoadMoreButton(result.hasMore);

  } catch (error) {
    console.error("Gagal refresh:", error);
  } finally {
    setTimeout(() => refreshIcon.classList.remove('fa-spin'), 600);
  }
}

// ⬇️ Fungsi Load More (Menambah data ke bawah tanpa menghapus yang lama)
async function loadMoreLogs() {
  const btn = document.getElementById('btnLoadMore');
  currentPage++; // Naikkan halaman

  btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memuat...`;

  try {
    const response = await fetch(`/wa/logs?page=${currentPage}`);
    const result = await response.json();

    if (result.success && result.data.length > 0) {
      renderRows(result.data); // Tambah row baru ke bawah
      toggleLoadMoreButton(result.hasMore);
    } else {
      toggleLoadMoreButton(false);
    }
  } catch (error) {
    console.error("Gagal load more:", error);
  } finally {
    btn.innerHTML = `<i class="fa-solid fa-angles-down"></i> Muat Lebih Banyak`;
  }
}
 

