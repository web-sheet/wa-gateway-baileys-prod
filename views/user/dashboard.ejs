        document.getElementById("statusDot").className =
          "w-3 h-3 rounded-full bg-emerald-400";

        document.getElementById("statusBadge").className =
          "px-4 py-2 rounded-full text-sm font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/20";

        document.getElementById("statusBadge").innerText =
