               class="w-72 rounded-2xl bg-white p-4 shadow-2xl">
          `;

        connectBtn.disabled = true;

        connectBtn.innerText =
          "Scan QR Code...";

        disconnectBtn.disabled = true;

      });

      // READY
      socket.on("ready", () => {

        statusText.innerText =
          "WhatsApp Connected ✅";

        waStatusEl.innerText =
