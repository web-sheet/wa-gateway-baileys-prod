      async function saveWebhook() {
  const webhookUrl = document.getElementById("webhookUrl").value;
  const webhookBotUrl = document.getElementById("webhookBotUrl").value; // Ambil input baru
  const statusEl = document.getElementById("webhookStatus");

  statusEl.className = "text-sm font-medium text-slate-400";
  statusEl.innerText = "⏳ Menyimpan pengaturan...";

  try {
    // Sesuaikan URL endpoint POST ini dengan rute backend kamu (misal: /api/webhook atau /settings/save)
// Di file dashboard HTML/EJS kamu, ubah bagian baris fetch menjadi:
const response = await fetch("/webhook/save", { 
  method: "POST",
  headers: {
    "Content-Type": "application/json",
  },
  body: JSON.stringify({ 
    webhookUrl: webhookUrl,
    webhookBotUrl: webhookBotUrl 
  }),
});

    const data = await response.json();

    if (response.ok) {
      statusEl.className = "text-sm font-medium text-emerald-400";
      statusEl.innerText = "✅ Semua Webhook berhasil diperbarui!";
      
      // Hilangkan pesan sukses setelah 3 detik
