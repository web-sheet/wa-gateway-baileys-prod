      connectBtn.onclick = async () => {

        connectBtn.disabled = true;
           resetBtn.disabled = true;

        statusText.innerText = "Menunggu QR Code...";

        try {

          await fetch("/wa/connect", {
            method: "POST"
          });

        } catch (error) {

          console.error(error);

          connectBtn.disabled = false;

          statusText.innerText =
            "Gagal menghubungi server";

        }

      };

      // DISCONNECT
      disconnectBtn.onclick = async () => {

        if (!confirm("Putuskan koneksi WhatsApp?"))
          return;

        disconnectBtn.disabled = true;

        statusText.innerText =
          "Memutuskan koneksi...";

        try {

          const res = await fetch("/wa/disconnect", {
            method: "POST"
          });

          const result = await res.json();

          if (!result.success) {

            alert(result.message);

            disconnectBtn.disabled = false;

          }

        } catch (error) {

          console.error(error);

          disconnectBtn.disabled = false;

          statusText.innerText =
            "Gagal disconnect";

        }

      };

          // DISCONNECT
      resetBtn.onclick = async () => {

        if (!confirm("Hapus Session WhatsApp?"))
          return;

        resetBtn.disabled = true;

        statusText.innerText =
          "Menghapus Session...";

        try {

          const res = await fetch("/wa/disconnect", {
            method: "POST"
          });

          const result = await res.json();

          if (!result.success) {

            alert(result.message);

            resetBtn.disabled = false;

          }

        } catch (error) {

          console.error(error);

          resetBtn.disabled = false;

          statusText.innerText =
            "Gagal reset WA";

        }

      };

      // QR
