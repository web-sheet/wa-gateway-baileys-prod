<style>
/* Chrome, Edge, Safari */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.25);
  border-radius: 9999px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(16, 185, 129, 0.6);
}

/* Firefox */
.custom-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: rgba(148,163,184,.25) transparent;
}
</style>

<%
const currentPath = typeof path !== "undefined"
  ? path
  : request?.path || "";

function isActive(url) {
  return currentPath === url;
}

const activeClass =
  "bg-emerald-500/15 border border-emerald-500/20 text-emerald-400 shadow-lg shadow-emerald-500/10";

const normalClass =
  "text-slate-300 hover:text-white hover:bg-white/10";
%>

<div class="lg:hidden sticky top-0 z-50 bg-slate-900/90 backdrop-blur-xl border-b border-white/10">
  <div class="flex items-center justify-between px-5 py-4">

    <div>
      <h1 class="font-bold text-lg text-white">
        Websheet Gateway
      </h1>

      <p class="text-xs text-slate-400">
        <%= user.role === 'admin'
          ? 'Admin Dashboard'
          : 'User Dashboard' %>
      </p>
    </div>

    <button
      id="menuBtn"
      class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 transition flex items-center justify-center">

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none"
           viewBox="0 0 24 24"
           stroke-width="1.5"
           stroke="currentColor"
           class="w-6 h-6">

        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />

      </svg>

    </button>

  </div>
</div>

<aside
  id="sidebar"
  class="fixed top-0 left-0 z-50 w-72 h-screen bg-slate-900 border-r border-white/10 transform -translate-x-full lg:translate-x-0 transition duration-300">

  <div class="h-full flex flex-col">

    <div class="p-6 border-b border-white/10">

      <a href="/dashboard">

        <h1 class="text-2xl font-bold text-white">
          Websheet Gateway
        </h1>

        <p class="text-sm text-slate-400 mt-1">
          <%= user.role === 'admin'
            ? 'Admin Dashboard'
            : 'User Dashboard' %>
        </p>

      </a>

    </div>

    <div class="p-6 border-b border-white/10">

      <div class="flex items-center gap-3">

        <div class="w-12 h-12 rounded-full bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold text-lg">
          <%= user.username?.charAt(0).toUpperCase() || 'U' %>
        </div>

        <div class="min-w-0">

          <p class="text-xs text-slate-500">
            Login sebagai
          </p>

          <p class="font-semibold text-emerald-400 truncate">
            <%= user.username %>
          </p>
     
        </div>

      </div>

    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">

      <% if (user.role === 'admin') { %>

      <a href="/admin"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/admin') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M18 18.72a9.094 9.094 0 0 0 3.742-.479
                   3 3 0 0 0-4.682-2.72m.94 3.198
                   .001.031c0 .225-.012.447-.037.666A11.944
                   11.944 0 0 1 12 21c-2.17 0-4.203-.576-5.964-1.584
                   A6.062 6.062 0 0 1 6 18.75m12 0a5.971
                   5.971 0 0 0-.941-3.197M6 18.75
                   a5.971 5.971 0 0 1 .94-3.197m0 0
                   a3 3 0 0 1 4.682-2.72m-4.682
                   2.72a9.094 9.094 0 0 1-3.742-.479
                   a3 3 0 0 1 4.682-2.72m.94 3.198
                   a5.971 5.971 0 0 1 .94 3.197" />

        </svg>

        Kelola User

      </a>

      <a href="/dashboard/blog/create"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard/blog/create') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg" 
             fill="none" 
             viewBox="0 0 24 24" 
             stroke-width="1.5" 
             stroke="currentColor" 
             class="w-5 h-5">
             
          <path stroke-linecap="round" 
                stroke-linejoin="round" 
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>

        Kelola Blog (Admin)

      </a>

      <% } %>

      <a href="/dashboard"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="m2.25 12 8.954-8.955c.44-.439
                   1.152-.439 1.591 0L21.75 12M4.5
                   9.75V19.5A2.25 2.25 0 0 0 6.75
                   21.75h10.5A2.25 2.25 0 0 0
                   19.5 19.5V9.75" />

        </svg>

        Dashboard

      </a>

      <a href="/dashboard/autoreply"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard/autoreply') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.625 9.75h6.75m-6.75
                   3h4.5m6.375 5.25a9 9 0 1 0-18
                   0h18Z" />

        </svg>

        Autoreply

      </a>

      <a href="/dashboard/broadcast"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard/broadcast') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/xl"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.34 3.94A9.776 9.776 0 0 1
                   18.75 3v11.25a9.776 9.776 0 0 1-8.41-.94
                   M5.25 6h2.25l7.5-3v15l-7.5-3H5.25A2.25
                   2.25 0 0 1 3 12.75v-4.5A2.25 2.25 0 0 1
                   5.25 6Z" />

        </svg>

        Broadcast

      </a>

      <a href="/dashboard/scheduled"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard/scheduled') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6l4 2m6-2a10 10 0
                   1 1-20 0 10 10 0 0 1 20 0Z"/>

        </svg>

        Pesan Terjadwal

      </a>

      <a href="/dashboard/scheduled-status"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/dashboard/scheduled-status') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="m4.5 12.75 6 6 9-13.5"/>

        </svg>

        Status Terjadwal

      </a>

      <a href="/contacts"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/contacts') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.25 6.75v10.5m0-10.5h1.5
                   a2.25 2.25 0 0 1 2.25 2.25v6
                   a2.25 2.25 0 0 1-2.25 2.25h-1.5" />

        </svg>

        Kontak

      </a>

      <a href="/documentation"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/documentation') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25V8.847a2.25 2.25 0 0
                   0-.659-1.591l-4.097-4.097A2.25
                   2.25 0 0 0 13.153 2.5H6.75A2.25
                   2.25 0 0 0 4.5 4.75v14.5A2.25
                   2.25 0 0 0 6.75 21.5h10.5A2.25
                   2.25 0 0 0 19.5 19.25v-5Z"/>

        </svg>

        Dokumentasi

      </a>

      <a href="/profile"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/profile') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-5 h-5">

          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6.75a3.75 3.75 0 1
                   1-7.5 0 3.75 3.75 0 0 1
                   7.5 0ZM4.5 20.118a7.5 7.5
                   0 0 1 15 0"/>

        </svg>

        Profil Saya

      </a>

      <a href="/blog" target="_blank"
         class="flex items-center gap-3 px-4 py-3 rounded-xl transition <%= isActive('/blog') ? activeClass : normalClass %>">

        <svg xmlns="http://www.w3.org/2000/svg" 
             fill="none" 
             viewBox="0 0 24 24" 
             stroke-width="1.5" 
             stroke="currentColor" 
             class="w-5 h-5">
             
          <path stroke-linecap="round" 
                stroke-linejoin="round" 
                d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
        </svg>

        Lihat Blog Publik

      </a>

    </div>

    <div class="p-4 border-t border-white/10">

      <a href="/logout"
         class="flex items-center justify-center w-full py-3 rounded-xl bg-red-500 hover:bg-red-600 transition font-medium <%= isActive('/logout') ? activeClass : normalClass %>">

        Logout

      </a>

    </div>

  </div>

</aside>

<div id="overlay"
     class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden">
</div>

<script>
const sidebar = document.getElementById("sidebar");
const menuBtn = document.getElementById("menuBtn");
const overlay = document.getElementById("overlay");

function openSidebar() {
  sidebar.classList.remove("-translate-x-full");
  overlay.classList.remove("hidden");
}

function closeSidebar() {
  sidebar.classList.add("-translate-x-full");
  overlay.classList.add("hidden");
}

menuBtn?.addEventListener("click", openSidebar);
overlay?.addEventListener("click", closeSidebar);
</script>