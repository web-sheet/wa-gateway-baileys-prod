    const row = `
      <tr class="border-b border-white/5 hover:bg-white/5 transition">
        <td class="px-4 py-4 whitespace-nowrap text-slate-400">${waktu}</td>
        <td class="px-4 py-4"><div class="flex flex-col gap-1"><span class="font-mono text-xs text-white">${nomor}</span>${badgeGrup}</div></td>
        <td class="px-4 py-4">${tipeText}</td>
        ${kolomPesanHtml}
        <td class="px-4 py-4">${mediaContent}</td>
        <td class="px-4 py-4">${statusBadge}</td>
        <td class="px-4 py-4">${aksiContent}</td>
      </tr>
    `;
    tbody.insertAdjacentHTML('beforeend', row);
  });
}


// --- 🌟 FUNGSI BARU: CEK APAKAH TEKS BENAR-BENAR TERPOTONG DI LAYAR ---
function checkOverflow(element) {
  const textWrapper = element.querySelector('.text-wrapper');
  const tooltipBox = element.querySelector('.tooltip-box');
  
  if (!textWrapper || !tooltipBox) return;

  // Bandingkan tinggi konten asli (scrollHeight) dengan tinggi kotak yang membatasi (clientHeight)
  const isClipped = textWrapper.scrollHeight > textWrapper.clientHeight;

  if (isClipped) {
    // Jika teks terpotong, aktifkan fitur hover tooltip Tailwind
    tooltipBox.classList.remove('hidden');
    element.classList.add('group'); 
    tooltipBox.classList.add('group-hover:visible', 'invisible');
  } else {
    // Jika teks muat dan tidak terpotong, pastikan tooltip dihancurkan/dihilangkan sama sekali
    tooltipBox.classList.add('hidden');
    element.classList.remove('group');
    tooltipBox.classList.remove('group-hover:visible', 'invisible');
  }
}
// Helper untuk menyembunyikan tombol jika data sudah habis
function toggleLoadMoreButton(hasMore) {
  const container = document.getElementById('loadMoreContainer');
  if (hasMore) {
    container.classList.remove('hidden');
  } else {
    container.classList.add('hidden');
  }
}





 
// --- FUNGSI PROSES KIRIM ULANG (OTOMATIS BACA API KEY DARI TEXTAREA) ---
async function resendMessage(btnElement, logData) {
  // Ubah status tombol jadi Loading
  const originalHtml = btnElement.innerHTML;
  btnElement.disabled = true;
  btnElement.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Memproses...`;

  let endpoint = '';
  let payload = {};

  // 🔐 1. Ambil API Key otomatis dari elemen textarea id="apiKey" yang ada di halaman kamu
  const apiKeyInput = document.getElementById('apiKey');
  const tokenApiKey = apiKeyInput ? apiKeyInput.value.trim() : '';

  if (!tokenApiKey) {
    alert('API Key tidak ditemukan di halaman ini. Silakan muat ulang halaman.');
    btnElement.disabled = false;
    btnElement.innerHTML = originalHtml;
    return;
  }

  // 2. Pemilihan rute berdasarkan jenis pesan asli (Kompatibel 100% dengan skema Backend)
  if (logData.messageType === 'image') {
    endpoint = '/api/send-image';
    payload = {
      number: [logData.to],
      images: [
        {
          url: logData.mediaUrl,
          caption: logData.message
        }
      ]
    };
  } else if (logData.messageType === 'document') {
    endpoint = '/api/send-document';
    payload = {
      number: [logData.to],
      documents: [
        {
          url: logData.mediaUrl,
          fileName: logData.fileName || 'Document.pdf',
          caption: logData.message || ''
        }
      ]
    };
  } else {
    // Jalur Pesan Teks Murni
    endpoint = '/api/send'; 
    payload = {
      number: logData.to, 
      message: logData.message
    };
  }

  try {
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': tokenApiKey // Mengirimkan API Key hasil tangkapan dari textarea
      },
      body: JSON.stringify(payload)
    });

    const result = await response.json();

    if (response.ok && result.success) {
      alert('Pesan berhasil dimasukkan kembali ke antrean!');
      location.reload(); // Reload halaman agar status tabel terupdate
    } else {
      alert('Gagal mengirim ulang: ' + (result.message || 'Error tidak diketahui'));
      btnElement.disabled = false;
      btnElement.innerHTML = originalHtml;
    }
  } catch (error) {
    console.error('Error Resend:', error);
    alert('Terjadi kesalahan koneksi saat mencoba kirim ulang.');
    btnElement.disabled = false;
    btnElement.innerHTML = originalHtml;
  }
}
   
   
   // --- FUNGSI UNTUK MENAMPILKAN POPUP MODAL PESAN FULL ---
function showModal(fullText) {
  // 1. Buat elemen HTML modal secara dinamis dengan Tailwind
  const modalHtml = `
    <div id="pesanModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm transition-opacity duration-300">
      <div class="bg-slate-900 border border-white/10 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">
        
        <div class="flex items-center justify-between px-6 py-4 border-b border-white/5 bg-slate-950/50">
          <h3 class="text-sm font-semibold text-indigo-400 inline-flex items-center gap-2">
            <i class="fa-solid fa-envelope-open-text"></i> Isi Pesan Lengkap
          </h3>
          <button onclick="closeModal()" class="text-slate-400 hover:text-white transition p-1">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>
        
        <div class="p-6 max-h-96 overflow-y-auto text-sm text-slate-200 whitespace-pre-line break-words font-sans selection:bg-indigo-500/30">
          ${fullText}
        </div>
        
        <div class="px-6 py-3 border-t border-white/5 bg-slate-950/30 flex justify-end">
          <button onclick="closeModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition">
            Tutup
          </button>
        </div>

      </div>
    </div>
  `;

  // 2. Suntikkan modal ke dalam body halaman
  document.body.insertAdjacentHTML('beforeend', modalHtml);
}

// --- FUNGSI UNTUK MENUTUP POPUP MODAL ---
function closeModal() {
  const modal = document.getElementById('pesanModal');
  if (modal) {
    modal.remove(); // Hapus modal dari HTML agar tidak menumpuk
  }
}
   
