<header
  class="sticky top-0 z-50 border-b border-white/10 bg-white/5 backdrop-blur-xl"
>
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-10">
      <a href="/dashboard" class="group block">
        <h1
          class="text-2xl font-bold text-white group-hover:text-indigo-400 transition"
        >
          Websheet Gateway
        </h1>
        <p class="text-slate-400 text-sm">
          <%= user.role === 'admin' ? 'Admin Dashboard' : 'User Dashboard' %>
        </p>
      </a>

      <nav class="hidden md:flex items-center gap-2">
            <% if (user.role === 'admin') { %>
            <a href="/admin"
                class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium">
                Kelola User
            </a>
            <% } %>

        <% if (user.role === 'admin') { %>


                <a
                href="/dashboard"
                class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
                >
                Dashboard
                </a>
        <% } %>


        <a
          href="/about"
          class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
        >
          About
        </a>

        <a
          href="/documentation"
          class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
        >
          Documentation
        </a>

        <a
          href="/contact"
          class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
        >
          Contact
        </a>

        <a
          href="/profile"
          class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
        >
          Profil Saya
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block text-right">
        <p class="text-sm text-slate-400">Login sebagai</p>

        <p class="font-semibold text-indigo-400"><%= user.username %></p>
      </div>

      <a
        href="/logout"
        class="hidden md:flex px-4 py-2 rounded-xl bg-red-500 hover:bg-red-600 transition font-medium shadow-lg shadow-red-500/20"
      >
        Logout
      </a>

      <button
        id="menuBtn"
        class="md:hidden w-11 h-11 rounded-xl bg-white/10 hover:bg-white/20 transition flex items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="hidden md:hidden border-t border-white/10 bg-slate-900/95 backdrop-blur-xl"
  >
    <div class="px-6 py-5 space-y-3">
      <div class="pb-4 border-b border-white/10">
        <p class="text-xs text-slate-500">Login sebagai</p>
        <p class="font-semibold text-indigo-400 mt-0.5">
          <%= user.username %> (<%= user.role %>)
        </p>
      </div>

  

                <% if (user.role === 'admin') { %>
           <a
        href="/admin"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
      >
        Admin
      </a>
            <% } %>


                            <% if (user.role === 'admin') { %>
      <a
        href="/dashboard"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
      >
        Dashboard
      </a>
            <% } %>



      <a
        href="/about"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
      >
        About
      </a>

      <a
        href="/documentation"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
      >
        Documentation
      </a>

      <a
        href="/contact"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium"
      >
        Contact
      </a>

      <a
        href="/profile"
        class="flex items-center px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/10 transition font-medium border border-white/5 bg-white/5"
      >
        Profil Saya
      </a>

      <a
        href="/logout"
        class="flex items-center justify-center px-4 py-3 rounded-2xl bg-red-500 hover:bg-red-600 transition font-medium shadow-lg shadow-red-500/20 mt-4"
      >
        Logout
      </a>
    </div>
  </div>
</header>

<script>
  // Script hamburger tetap dipertahankan agar fungsi klik di HP tidak mati
  (() => {
    const menuBtn = document.getElementById("menuBtn");
    const mobileMenu = document.getElementById("mobileMenu");
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    }
  })();
</script>
