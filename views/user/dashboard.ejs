<div class="bg-white/5 border border-white/10 rounded-3xl p-6 backdrop-blur-xl shadow-2xl">

  <div class="mb-5">
    <h3 class="text-xl font-bold">
      Webhook Integration
    </h3>
    <p class="text-slate-400 text-sm mt-1">
      Endpoint untuk meneruskan event dan pesan WhatsApp ke server Anda
    </p>
  </div>

  <div class="space-y-5">
    
    <div>
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
        Webhook Absensi & Transaksi (Lokasi & Prefiks)
      </label>
      <input
        type="text"
        id="webhookUrl"
        value="<%= user.webhookUrl || '' %>"
        placeholder="https://domainanda.com/webhook-accounting"
        class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition"
      />
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>Webhook Bot Respon (Pesan Teks Umum)</span>
        <span class="text-[10px] uppercase font-bold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-md">Baru</span>
      </label>
      <input
        type="text"
        id="webhookBotUrl"
        value="<%= user.webhookBotUrl || '' %>"
        placeholder="https://domainanda.com/webhook-bot"
        class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition"
      />
      <p class="text-[11px] text-slate-400/70 mt-1.5 pl-1">
        *Kosongkan jika Anda tidak ingin membuat bot respon otomatis untuk chat umum.
      </p>
    </div>

    <button onclick="saveWebhook()"
            class="w-full py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-600 transition font-semibold shadow-lg shadow-emerald-500/20 mt-2">
      Simpan Semua Webhook
    </button>

    <div id="webhookStatus" class="text-sm font-medium"></div>

  </div>
</div>



