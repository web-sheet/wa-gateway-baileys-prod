    }
  } catch (error) {
    statusEl.className = "text-sm font-medium text-rose-400";
    statusEl.innerText = "❌ Gagal menyimpan: " + error.message;
  }
}



async function sendManualMessage(event) {

  // Prevent reload
  event.preventDefault();

  const apiKey =
    document.getElementById("apiKey").value;

  const number =
    document.getElementById("sendTarget").value;

  const message =
    document.getElementById("sendMessageBody").value;

  const sendBtn =
    document.getElementById("sendMsgBtn");

  const statusEl =
    document.getElementById("sendMsgStatus");

  // VALIDASI
  if (!apiKey) {

    alert(
      "API Key tidak ditemukan"
    );

    return;

  }

  // LOADING
  sendBtn.disabled = true;

  sendBtn.innerHTML =
    `
    <svg class="animate-spin h-5 w-5"
         xmlns="http://www.w3.org/2000/svg"
         fill="none"
         viewBox="0 0 24 24">

      <circle class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4">
      </circle>

      <path class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v8H4z">
      </path>

    </svg>

    Mengirim...
    `;

  statusEl.innerHTML =
    `
    <span class="text-yellow-400">
      Sedang mengirim pesan...
    </span>
    `;

  try {

    const res =
      await fetch("api/send", {

        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "x-api-key": apiKey
        },

        body: JSON.stringify({
          number,
          message
        })

      });

    const result =
      await res.json();

    // SUCCESS
    if (result.success) {

      statusEl.innerHTML =
        `
        <span class="text-emerald-400">
          ✅ Pesan berhasil dikirim ke ${result.target}
        </span>
        `;

      // RESET FORM
      document.getElementById("sendTarget").value =
        "";

      document.getElementById("sendMessageBody").value =
        "";

    } else {

      statusEl.innerHTML =
        `
        <span class="text-red-400">
          ❌ ${result.message || result.error}
        </span>
        `;

    }

  } catch (error) {

    console.error(error);

    statusEl.innerHTML =
      `
      <span class="text-red-400">
        ❌ Terjadi kesalahan koneksi server
      </span>
      `;

  } finally {

    // RESET BUTTON
    sendBtn.disabled = false;

    sendBtn.innerHTML =
      `
      <svg xmlns="http://www.w3.org/2000/svg"
           class="w-5 h-5"
           fill="none"
           viewBox="0 0 24 24"
           stroke="currentColor">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14.752 11.168l-9.193-5.11A1 1 0 004 6.941v10.118a1 1 0 001.559.832l9.193-5.11a1 1 0 000-1.664z" />

      </svg>

      Kirim Pesan
      `;

  }

}




 
