    <%= user.waStatus === 'connected' ? 'disabled' : '' %>
    class="flex-1 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-600 disabled:opacity-50 transition font-semibold">
    <%= user.waStatus === 'connected' ? 'Sudah Terhubung' : 'Connect WhatsApp' %>
