// LOAD GROUPS
document.getElementById("loadGroups").onclick = async () => {

  try {

    const res =
      await fetch(`/wa/${userId}/groups`);

    const result =
      await res.json();

    if (!result.success)
      throw new Error(result.error);

    window.allGroups =
      result.data;

    renderGroups(result.data);

  } catch (err) {

    console.error(err);

    alert(err.message);

  }

};

// RENDER GROUPS
function renderGroups(groups) {

  const groupList =
    document.getElementById("groupList");

  const empty =
    document.getElementById("groupEmpty");

  if (!groups.length) {

    groupList.innerHTML = "";

    empty.classList.remove("hidden");

    return;

  }

  empty.classList.add("hidden");

  const html =
    groups.map(group => `

      <tr class="border-b border-white/5 hover:bg-white/5 transition">

        <!-- Name -->
        <td class="px-6 py-4">

          <div class="flex items-center gap-3">

            <div class="w-11 h-11 rounded-xl bg-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">

              ${group.name.charAt(0).toUpperCase()}

            </div>

            <div>

              <p class="font-semibold text-white">
                ${group.name}
              </p>

              <p class="text-xs text-slate-500 mt-1">
                WhatsApp Group
              </p>

            </div>

          </div>

        </td>

        <!-- ID -->
        <td class="px-6 py-4">

          <div class="max-w-[260px] truncate text-slate-300 text-sm">

            ${group.id}

          </div>

        </td>

        <!-- Members -->
        <td class="px-6 py-4">

          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">

            ${group.size || 0} Members

          </span>

        </td>

        <!-- Action -->
        <td class="px-6 py-4 text-center">

          <button onclick="copyGroupId('${group.id}')"
                  class="px-4 py-2 rounded-xl bg-indigo-500 hover:bg-indigo-600 transition text-sm font-medium">

            Copy ID

          </button>

        </td>

      </tr>

    `).join("");

  groupList.innerHTML =
    html;

}

// SEARCH
document.getElementById("searchGroup")
  .addEventListener("input", function () {

    const keyword =
      this.value.toLowerCase();

    const filtered =
      window.allGroups.filter(group => {

        return (
          group.name.toLowerCase().includes(keyword) ||
          group.id.toLowerCase().includes(keyword)
        );

      });

    renderGroups(filtered);

  });

