            <div class="w-24 h-24 rounded-full bg-emerald-500/20 flex items-center justify-center mx-auto mb-4">

              <svg xmlns="http://www.w3.org/2000/svg"
                   class="w-12 h-12 text-emerald-400"
                   fill="none"
                   viewBox="0 0 24 24"
                   stroke="currentColor">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7" />

              </svg>

            </div>

            <h3 class="text-xl font-bold text-emerald-400">
              WhatsApp Connected
            </h3>
          </div>
