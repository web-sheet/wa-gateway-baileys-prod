<div class="lg:ml-72 p-6 mx-auto px-6 py-8">
  
  <div class="bg-slate-800 border border-slate-700/70 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-6 border-b border-slate-700/50 bg-slate-800/50 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold flex items-center gap-2 text-amber-400">
          <i class="fa-solid fa-pen-to-square"></i> Edit Artikel Blog
        </h2>
        <p class="text-xs text-slate-400 mt-1">Lakukan perubahan konten agar artikel tetap relevan dan optimal di mata Google.</p>
      </div>
      <a href="/dashboard/blog/create" class="text-xs bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-xl transition">
        <i class="fa-solid fa-arrow-left mr-1"></i> Batal
      </a>
    </div>

    <form action="/dashboard/blog/update/<%= article._id %>" method="POST" id="blogForm" class="p-6 space-y-5">
      
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Judul Artikel</label>
        <input type="text" name="title" value="<%= article.title %>" required
          class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-amber-500 text-sm transition">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Meta Description (SEO)</label>
        <textarea name="metaDesc" rows="2" maxlength="160" required
          class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-amber-500 text-sm transition"><%= article.metaDesc %></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Isi Konten Artikel</label>
        <div class="bg-slate-900 rounded-xl border border-slate-700 overflow-hidden text-slate-200">
          <div id="editor" class="min-h-[300px] text-sm">
            <%- article.content %>
          </div>
        </div>
        <input type="hidden" name="content" id="contentInput">
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-slate-700/50">
        <div class="w-full sm:w-1/3">
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Status Publikasi</label>
          <select name="status" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500 transition cursor-pointer">
            <option value="published" class="bg-slate-900" <%= article.status === 'published' ? 'selected' : '' %>>🚀 Publish Langsung</option>
            <option value="draft" class="bg-slate-900" <%= article.status === 'draft' ? 'selected' : '' %>>📁 Simpan Sebagai Draft</option>
          </select>
        </div>

        <div class="flex justify-end pt-2 sm:pt-0">
          <button type="submit" class="w-full sm:w-auto bg-amber-600 hover:bg-amber-500 text-white font-medium px-6 py-2.5 rounded-xl text-sm transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-square-check"></i> Perbarui Artikel
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

<style>
  .ql-toolbar.ql-snow { background-color: #1e293b !important; border-color: #334155 !important; border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem; }
  .ql-container.ql-snow { border-color: #334155 !important; border-bottom-left-radius: 0.75rem; border-bottom-right-radius: 0.75rem; background-color: #0f172a; }
  .ql-snow .ql-stroke { stroke: #94a3b8 !important; }
  .ql-snow .ql-fill { fill: #94a3b8 !important; }
  .ql-snow .ql-picker { color: #94a3b8 !important; }
  .ql-editor { color: #f1f5f9 !important; font-family: ui-sans-serif, system-ui, sans-serif; }
</style>

<script>
  // Inisialisasi Quill
  const quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline'],
        [{ 'header': [1, 2, false] }],
        ['link', 'blockquote', 'code-block'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }]
      ]
    }
  });

  // Salin HTML ke input tersembunyi saat disubmit
  const form = document.getElementById('blogForm');
  form.onsubmit = function() {
    const contentInput = document.getElementById('contentInput');
    const htmlContent = quill.root.innerHTML;
    
    if (htmlContent === '<p><br></p>' || htmlContent.trim() === '') {
      alert('Isi konten artikel blog tidak boleh kosong!');
      return false;
    }
    contentInput.value = htmlContent;
  };
</script>