<div class="bg-white/5 border border-white/10 rounded-3xl p-6 backdrop-blur-xl shadow-2xl mt-5">

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
      <h3 class="text-xl font-bold flex items-center mb-2">
        <i class="fa-solid fa-clock-rotate-left text-emerald-400 mr-2"></i>
        Riwayat Pengiriman
      </h3>
      <span id="totalPesanCount" class="text-xs font-mono px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
          <%= typeof totalLogs !== 'undefined' ? totalLogs : logs.length %> Pesan
        </span>
      <p class="text-slate-400 text-sm my-3">
        Riwayat pengiriman pesan 7 hari terakhir
      </p>
    </div>

    <button type="button" onclick="refreshLogTable()"
       class="px-5 py-3 rounded-2xl bg-indigo-500 hover:bg-indigo-600 transition font-semibold shadow-lg shadow-indigo-500/20 text-white flex items-center justify-center gap-2">
      <i class="fa-solid fa-rotate-right" id="refreshIcon"></i>
      Refresh
    </button>
  </div>

  <div class="mb-5">
    <div class="relative">
      <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
      <input
        type="text"
        id="logSearch"
        placeholder="Cari nomor, grup, isi pesan..."
        class="w-full bg-black/20 border border-white/10 rounded-2xl py-3 pl-11 pr-4 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      />
    </div>
  </div>

<div class="overflow-auto rounded-2xl border border-white/10 max-h-[650px]">
  <table class="w-full text-sm">
    <thead class="sticky top-0 bg-slate-900/95 backdrop-blur-xl z-10">
      <tr class="text-slate-400 border-b border-white/10">
        <th class="text-left px-4 py-4 font-semibold">Waktu</th>
        <th class="text-left px-4 py-4 font-semibold">Tujuan</th>
        <th class="text-left px-4 py-4 font-semibold">Tipe</th>
        <th class="text-left px-4 py-4 font-semibold">Pesan</th>
        <th class="text-left px-4 py-4 font-semibold">Lampiran</th>
        <th class="text-left px-4 py-4 font-semibold">Status</th>
        <th class="text-left px-4 py-4 font-semibold">Aksi</th>
      </tr>
    </thead>
    <tbody id="logsTable">
      <% if (logs.length === 0) { %>
        <tr id="emptyRow">
          <td colspan="7" class="text-center py-16 text-slate-500">
            <i class="fa-regular fa-folder-open text-4xl mb-3 block"></i>
            Belum ada riwayat pengiriman pesan
          </td>
        </tr>
      <% } else { %>
        <% logs.forEach(log => { %>
          <tr class="border-b border-white/5 hover:bg-white/5 transition">
            <td class="px-4 py-4 whitespace-nowrap text-slate-400">
              <%= new Date(log.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %>
            </td>

            <td class="px-4 py-4">
              <div class="flex flex-col gap-1">
                <span class="font-mono text-xs text-white">
                  <%= log.to ? log.to.split('@')[0] : '-' %>
                </span>
                <% if(log.to && log.to.includes('@g.us')) { %>
                  <span class="inline-flex w-fit px-2 py-1 rounded-full bg-cyan-500/20 text-cyan-400 text-xs">
                    Grup
                  </span>
                <% } %>
              </div>
            </td>

            <td class="px-4 py-4">
              <% if(log.messageType === 'image'){ %>
                <span class="inline-flex items-center gap-2 text-emerald-400">
                  <i class="fa-solid fa-image"></i> Gambar
                </span>
              <% } else if(log.messageType === 'document'){ %>
                <span class="inline-flex items-center gap-2 text-yellow-400">
                  <i class="fa-solid fa-file-lines"></i> Dokumen
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-2 text-indigo-400">
                  <i class="fa-solid fa-comment"></i> Teks
                </span>
              <% } %>
            </td>

            <% const pesan = log.message || ''; %>
            <% if (!pesan) { %>
              <td class="px-4 py-4 text-slate-500 italic text-xs">Tanpa teks</td>
            <% } else if (pesan.length > 60) { %>
              <td class="px-4 py-4" title="<%= pesan.replace(/"/g, '&quot;') %>">
                <div class="max-w-md line-clamp-2 text-slate-300 cursor-help">
                  <%= pesan %>
                </div>
              </td>
            <% } else { %>
              <td class="px-4 py-4">
                <div class="max-w-md text-slate-300">
                  <%= pesan %>
                </div>
              </td>
            <% } %>

            <td class="px-4 py-4">
              <% if(log.mediaUrl){ %>
                <a href="<%= log.mediaUrl %>" target="_blank" class="text-emerald-400 hover:text-emerald-300 transition inline-flex items-center gap-1">
                  <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  <%= log.messageType === 'document' ? (log.fileName || 'Lihat Berkas') : 'Lihat' %>
                </a>
              <% } else { %>
                <span class="text-slate-500">-</span>
              <% } %>
            </td>

            <td class="px-4 py-4">
              <% if(log.status === 'sent'){ %>
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-400 text-xs">
                  <i class="fa-solid fa-circle-check"></i> Terkirim
                </span>
              <% } else if(log.status === 'failed'){ %>
                <span title="<%= log.errorReason %>" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/15 text-red-400 text-xs cursor-help">
                  <i class="fa-solid fa-circle-xmark"></i> Gagal
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-500/15 text-yellow-400 text-xs">
                  <i class="fa-solid fa-clock"></i> Antri
                </span>
              <% } %>
            </td>

            <td class="px-4 py-4">
              <% if(log.status === 'failed') { %>
                <button 
                  onclick='resendMessage(this, <%- JSON.stringify(log).replace(/'/g, "&apos;") %>)'
